{
  "name": "gossip",
  "private": true,
  "version": "0.1.0",
  "description": "Gossip — red social de descubrimiento local potenciada por IA",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@gossip/api",
    "dev:web": "npm run dev --workspace=@gossip/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@gossip/api",
    "db:migrate": "npm run db:migrate --workspace=@gossip/api"
  },
  "engines": {
    "node": ">=20"
  }
}
