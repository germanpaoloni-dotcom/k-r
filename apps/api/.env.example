NODE_ENV=development
PORT=4000

# Postgres (local dev — ver docker-compose.yml en la raíz)
DATABASE_URL=postgres://kor:kor@localhost:5432/kor_dev

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
