NODE_ENV=development
PORT=4000

# Postgres (local dev — ver docker-compose.yml en la raíz)
DATABASE_URL=postgres://gossip:gossip@localhost:5432/gossip_dev

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS
WEB_ORIGIN=http://localhost:3000

# Redis (opcional — cache de Orbes). Si no está seteado o no conecta, cae
# a un cache en memoria del proceso; nunca rompe el arranque de la API.
# REDIS_URL=redis://localhost:6379

# Gossip AI (Fase 7, opcional). Sin esto, /ai/que-hago cae al fallback
# heurístico (domains/ai/heuristics.ts) — nunca rompe el arranque de la API.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
